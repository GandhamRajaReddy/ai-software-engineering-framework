{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ASEF Evidence Record Schema",
  "type": "object",
  "required": [
    "id",
    "type",
    "timestamp",
    "sourceTreeHash",
    "isMock",
    "provenance",
    "data"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "TEST_EXECUTION",
        "SECURITY_SCAN",
        "CODE_REVIEW",
        "DEPLOYMENT_CHECK",
        "STAGE_EXECUTION",
        "RELEASE_DECISION",
        "test-suite",
        "security-audit",
        "stage-execution",
        "release-decision"
      ]
    },
    "timestamp": {
      "type": "string"
    },
    "sourceTreeHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sourceHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "isMock": {
      "type": "boolean"
    },
    "stale": {
      "type": "boolean"
    },
    "provenance": {
      "type": "object",
      "required": ["agent", "backend"],
      "properties": {
        "agent": { "type": "string" },
        "backend": { "type": "string" },
        "gitCommit": { "type": ["string", "null"] },
        "loadedSkills": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "data": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
